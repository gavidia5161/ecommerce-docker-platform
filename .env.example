# Para uso local académico. Estos valores de ejemplo NO son para producción.
# Nombre lógico de la aplicación y modo de ejecución de Laravel.
APP_NAME=Ecommerce
APP_ENV=production
APP_DEBUG=false
# URL pública local que usa Laravel para generar enlaces.
APP_URL=http://localhost:8000
# Clave local de cifrado (base64, 32 bytes). Reemplazar en cualquier despliegue real.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Secreto local para firmar tokens JWT; reemplazar en cualquier despliegue real.
JWT_SECRET=solo-para-desarrollo-cambiar-antes-de-desplegar
# Nivel de detalle de los registros de Laravel.
LOG_LEVEL=info

# MySQL local dentro de Docker. La API usa MYSQL_USER, no la cuenta root.
# Contraseña administrativa inicial de MySQL.
MYSQL_ROOT_PASSWORD=local-root-password-change-me
# Base de datos que MySQL crea al inicializar el volumen.
MYSQL_DATABASE=ecommerce
# Usuario de aplicación y contraseña usados por Laravel.
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=local-app-password-change-me

# Stripe es opcional para ver el catálogo; usa claves de prueba para probar pagos.
# Clave pública que Next.js incorpora durante el build.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Clave pública y secreta que usaría Laravel para procesar pagos.
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
